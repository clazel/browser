/target
# Build directories left by running cargo inside a crate (e.g. crates/clazel-x509/target).
/crates/*/target/
**/*.rs.bk
.DS_Store
/.verus-log
# Verus SMT solver logs; single files can exceed GitHub's 100 MB limit.
/.verus-solver-log/
/kani-out
# `cargo xtask verify --part crate` measurements (xtask/src/parts.rs)
/parts/
# Local agent checkouts and per-machine permissions.
/.claude/worktrees/
/.claude/settings.local.json
